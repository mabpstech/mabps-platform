# Better Auth
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000

# SQLite database file (created automatically)
DATABASE_URL=./data/mabps.db

# Google OAuth (optional — leave empty to hide Google sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email delivery (optional — without this, reset/invite links are logged to the server console)
# RESEND_API_KEY=
# EMAIL_FROM=MABPS <noreply@yourdomain.com>

# Stripe Billing (required for paid plans)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Optional publishable key if you add Stripe.js later
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Meta WhatsApp Cloud API (required to accept webhook POSTs)
# App Secret from Meta Developer → App settings → Basic
WHATSAPP_APP_SECRET=

# Stripe Price IDs for each paid plan + interval
STRIPE_PRICE_STARTER_MONTHLY=price_...
STRIPE_PRICE_STARTER_YEARLY=price_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_YEARLY=price_...
STRIPE_PRICE_ENTERPRISE_MONTHLY=price_...
STRIPE_PRICE_ENTERPRISE_YEARLY=price_...
