# Better Auth
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000

# Public app URL (used by proxy redirects, Stripe return URLs, OpenRouter referer, email tracking)
# Prefer the canonical browser-facing origin; often same as BETTER_AUTH_URL in local/dev.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (libSQL)
# Local SQLite file for development (created automatically):
DATABASE_URL=./data/mabps.db
# Production Turso / remote libSQL:
# DATABASE_URL=libsql://your-db-name-org.turso.io
# AUTH_TOKEN=eyJ...
# Driver: sqlite (local file, default) | libsql (Turso; also auto-detected from remote DATABASE_URL)
# DATABASE_DRIVER=sqlite
# postgres remains unimplemented — see docs/DB_MIGRATION_PATH.md

# Automation background worker (required in production when using npm run automation:worker)
# Shared secret for POST /api/automation/queue/process (header: x-automation-worker-secret)
# AUTOMATION_WORKER_SECRET=
# AUTOMATION_WORKER_ID=worker-1
# AUTOMATION_WORKER_INTERVAL_MS=2000
# AUTOMATION_WORKER_LIMIT=25

# Media blob storage
# Auto (unset): local FS in local SQLite dev; Turso/SQLite BLOB (db) on Vercel or remote DATABASE_URL
# Explicit: local | db | s3 (or r2 / turso aliases)
# MEDIA_STORAGE_DRIVER=db
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true

# Google OAuth (optional — leave empty to hide Google sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email delivery (optional — without this, reset/invite links are logged to the server console)
# RESEND_API_KEY=
# EMAIL_FROM=MABPS <noreply@yourdomain.com>

# Stripe Billing (required for paid plans)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs for each paid plan + interval
STRIPE_PRICE_STARTER_MONTHLY=price_...
STRIPE_PRICE_STARTER_YEARLY=price_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_YEARLY=price_...
STRIPE_PRICE_ENTERPRISE_MONTHLY=price_...
STRIPE_PRICE_ENTERPRISE_YEARLY=price_...

# Razorpay Billing (optional alternative to Stripe)
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
RAZORPAY_WEBHOOK_SECRET=

# Razorpay Plan IDs for each paid plan + interval
RAZORPAY_PLAN_STARTER_MONTHLY=plan_...
RAZORPAY_PLAN_STARTER_YEARLY=plan_...
RAZORPAY_PLAN_PRO_MONTHLY=plan_...
RAZORPAY_PLAN_PRO_YEARLY=plan_...
RAZORPAY_PLAN_ENTERPRISE_MONTHLY=plan_...
RAZORPAY_PLAN_ENTERPRISE_YEARLY=plan_...

# Meta WhatsApp Cloud API (required to accept webhook POSTs)
# App Secret from Meta Developer → App settings → Basic
WHATSAPP_APP_SECRET=

# Knowledge / embeddings
# Without an OpenAI key, the platform falls back to local hash embeddings (weaker retrieval).
# OPENAI_API_KEY=sk-...
# Alias accepted by the embedder (same effect as OPENAI_API_KEY):
# MABPS_OPENAI_API_KEY=
# Optional overrides (defaults shown):
# MABPS_KB_EMBEDDING_PROVIDER=local   # local | openai | auto
# MABPS_KB_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_BASE_URL=https://api.openai.com/v1
# Vector store: sqlite (default, in-process cosine) | pgvector (dedicated Postgres)
# MABPS_KB_VECTOR_STORE=sqlite
# VECTOR_DATABASE_URL=postgres://user:pass@host:5432/mabps_vectors

# Platform cache for entitlements / settings (P3-4)
# CACHE_DRIVER=memory          # memory (default) | redis (Upstash REST invalidation)
# CACHE_TTL_MS=30000
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Automation event schema validation (P3-6): compat (default) | strict
# PLATFORM_EVENT_SCHEMA_MODE=compat

# Billing cron / scheduled jobs (required in production for trial-ending emails)
# Prefer BILLING_JOB_SECRET; CRON_SECRET is accepted as a fallback alias.
# Authorization: Authorization: Bearer <secret>  OR  x-billing-job-secret: <secret>
# BILLING_JOB_SECRET=
# CRON_SECRET=

# Secrets at rest (optional — encrypts stored provider tokens when set)
# MABPS_SECRETS_KEY=
